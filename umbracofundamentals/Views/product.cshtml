@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Product>;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "childPage.cshtml";
}
<link rel="stylesheet" href="@Url.Content("~/css/blockGridLayout.css")" />

<section class="bg-white">
    <div class="container">
        <div class="section-content">
            @await Html.GetBlockGridHtmlAsync(Model, "productGrid")

            <br/>
 
            <h3>Customer reviews</h3>
            @await Html.GetBlockListHtmlAsync(Model, "Reviews")

        </div>
    </div>
</section>
